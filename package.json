{
  "name": "project-setup-automations",
  "version": "1.0.0",
  "private": true,
  "description": "Stage 5 project setup: once a mentor is assigned, update the WhatsApp group, link the mentor on SYNC, create the student's Google Drive and copy in the curriculum",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "run-once": "tsx src/run-once.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
