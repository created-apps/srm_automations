# =============================================================================
# Stage 5 project-setup service -- configuration
#
# Copy to .env and fill in. Real environment variables win over the file, so on
# Railway set these in the service variables and leave .env out of the image.
# =============================================================================

# --- Shared Supabase --------------------------------------------------------
# The SAME project as the assessment-automations and Automations services. This
# service reads public.group_cases and owns public.project_setups, both reached
# over PostgREST with the service key (which bypasses row-level security).
# Create the table once by running sql/001_project_setup.sql in the SQL editor.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# --- SYNC (separate Supabase) -----------------------------------------------
# SYNC is its own Supabase project. Step 2 ("add mentor on SYNC") inserts the
# mentor's user_group_memberships row on the student's group. Service key -- it
# bypasses RLS. Leave unset and step 2 is SKIPPED (the rest still runs).
SYNC_SUPABASE_URL=https://<sync-ref>.supabase.co
SYNC_SUPABASE_SERVICE_KEY=

# --- Periskope (WhatsApp) ---------------------------------------------------
# Same workspace/number as the other services. Step 1 edits the group's name
# and description via POST /chats/{chat_id}/settings.
PERISKOPE_API_KEY=
PERISKOPE_PHONE=
PERISKOPE_BASE_URL=https://api.periskope.app/v1

# --- Google Drive -----------------------------------------------------------
# A Google service account (its own Drive). Folders are created inside a Shared
# Drive the service account is a member of, so they don't count against a
# personal quota and stay visible to the team.
#
# Paste the service account's client_email and private_key from its JSON key.
# The private key is multi-line: keep the literal "\n" escapes on one line, OR
# wrap the whole value in double quotes with real newlines. The loader accepts
# both.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# The Shared Drive that student folders are created in. The service account
# must be a member with at least Content Manager.
GOOGLE_SHARED_DRIVE_ID=
# Optional: a folder within that Shared Drive to nest student folders under.
# Leave blank to create them at the drive root.
GOOGLE_STUDENTS_PARENT_FOLDER_ID=
# Editor access granted on EVERY student folder as it is created -- the ops
# team, in practice. Comma-separated. Mentors are NOT listed here: they are
# granted access individually, and only once introduced to the family.
DRIVE_AUTO_ACCESS_EMAILS=

# --- Curriculum templates ---------------------------------------------------
# Step 4 copies the contents of a per-subject template folder into the student
# folder. Map each subject label (as chosen in the dashboard) to a Drive folder
# id. JSON object, subject -> folder id. Matching is case-insensitive.
# Example: {"AI":"1AbC...","Biology":"1DeF...","AI+Bio":"1GhI..."}
CURRICULUM_TEMPLATES_JSON={}

# --- COSMIC LMS -------------------------------------------------------------
# Steps 5/6 create the student account and their project in COSMIC LMS.
# Base URL is the deployed API host (the frontend proxies /api to it). The token
# comes from logging in with this account. It must be a SUPER_ADMIN: creating a
# student needs manager, but verifying/approving the account (so the student can
# log in) needs super_admin. Leave unset and both COSMIC steps are SKIPPED.
COSMIC_BASE_URL=https://cosmic-production-66e0.up.railway.app
COSMIC_ADMIN_EMAIL=
COSMIC_ADMIN_PASSWORD=
# product | research | product_research
COSMIC_PROJECT_TRACK=product
# Project end_date = start (today) + this many weeks.
COSMIC_PROJECT_DURATION_WEEKS=12
# Login URL included in the credentials message sent to the student.
COSMIC_LOGIN_URL=https://cosmic.create-ed.in

# --- Slack (notifications only) ---------------------------------------------
# Reuse the assessment-automations bot token + channel. This service only posts
# a short note when a case's setup completes or fails. chat:write is enough.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_BASE_URL=https://slack.com/api

# --- Dashboard link (for Slack notes) ---------------------------------------
# Public URL of the ops dashboard, so a failure note can deep-link to the case.
DASHBOARD_URL=https://ops.example.com

# --- Reconciliation cron ----------------------------------------------------
PORT=3000
# Every 5 minutes. The cron scans for mentor-assigned cases whose project
# details are filled and not yet set up, and runs them.
SETUP_CRON=*/5 * * * *
# Give up after this many failed attempts on a case (it stays FAILED and is
# surfaced in the dashboard/Slack for a human). 0 = keep retrying forever.
SETUP_MAX_ATTEMPTS=5
